#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034
USE_PROCD=1
START=97
STOP=4

PROG=/usr/sbin/unravel
SERVICE_NAME="unravel"

service_triggers() {
    procd_add_reload_trigger "$SERVICE_NAME"
}

bool_to_int() {
    case "$1" in
        1|true|yes|y|on|enabled) echo 1 ;;
        *) echo 0 ;;
    esac
}

start_service() {
    # shellcheck disable=SC3043
    local syslog_out

    syslog_out=$(uci -q get "${SERVICE_NAME}.@output[0].use_syslog") || syslog_out=1
    syslog_out=$(bool_to_int "$syslog_out")

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn
    procd_set_param stdout "$syslog_out"
    procd_set_param stderr "$syslog_out"
    procd_close_instance
}
